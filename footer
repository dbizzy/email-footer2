<table width="650" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;mso-table-lspace:0;mso-table-rspace:0;">
  <tr>
    <!-- LEFT: Logo -->
    <td width="124" align="center" valign="middle" bgcolor="#004987" style="padding:0;">
      <img src="https://en.wikipedia.org/wiki/Backwell_School#/media/File:BackwellSchool_Logo.png" alt="Logo" width="100" height="100" style="display:block;margin:15px auto;border:0;">
    </td>

    <!-- MIDDLE: Name + Title -->
    <td width="310" valign="middle" bgcolor="#004987" style="padding:0 10px;font-family:Arial, sans-serif;color:#FFFFFF;vertical-align:middle;">
      <div style="font-size:24px;line-height:28px;font-weight:bold;">%%FirstName%% %%LastName%%</div>
      <div style="font-size:18px;line-height:22px;">%%Title%%</div>
    </td>

    <!-- RIGHT: Contact Info -->
    <td width="216" valign="top" bgcolor="#004987" style="padding:7px 5px 7px 0;font-family:Arial, sans-serif;color:#FFFFFF;font-size:14px;line-height:18px;">
      
      <!-- EMAIL -->
      <table cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;">
        <tr>
          <td width="25" valign="middle" style="padding-right:5px;">
            <img src="https://raw.githubusercontent.com/pconkie/emailfooter/main/mail25.png" alt="Email" width="25" height="25" style="display:block;border:0;">
          </td>
          <td valign="middle" style="word-break:break-word;">
            <a href="mailto:mailbox@backwellschool.net" style="color:#FFFFFF;text-decoration:none;font-family:Arial, sans-serif;font-size:14px;line-height:18px;">
              mailbox@backwellschool.net
            </a>
          </td>
        </tr>
      </table>

      <!-- PHONE -->
      <table cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;">
        <tr>
          <td width="25" valign="middle" style="padding-right:5px;">
            <img src="https://raw.githubusercontent.com/pconkie/emailfooter/main/phone25.png" alt="Phone" width="25" height="25" style="display:block;border:0;">
          </td>
          <td valign="middle">01275 463371</td>
        </tr>
      </table>

      <!-- WEBSITE -->
      <table cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;">
        <tr>
          <td width="25" valign="middle" style="padding-right:5px;">
            <img src="https://raw.githubusercontent.com/pconkie/emailfooter/main/web25.png" alt="Website" width="25" height="25" style="display:block;border:0;">
          </td>
          <td valign="middle">
            <a href="https://www.backwellschool.net" style="color:#FFFFFF;text-decoration:none;font-family:Arial, sans-serif;font-size:14px;line-height:18px;">
              www.backwellschool.net
            </a>
          </td>
        </tr>
      </table>

      <!-- ADDRESS -->
      <table cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse:collapse;">
        <tr>
          <td width="25" valign="top" style="padding-right:5px;">
            <img src="https://raw.githubusercontent.com/pconkie/emailfooter/main/pin25.png" alt="Address" width="25" height="25" style="display:block;border:0;">
          </td>
          <td valign="top" style="word-break:break-word;">
            Backwell School, Station Road,<br>Backwell, Bristol BS48 3BX
          </td>
        </tr>
      </table>

    </td>
  </tr>

  <!-- GOLD BAR -->
  <tr>
    <td colspan="3" height="10" bgcolor="#FFC000" style="line-height:0;font-size:0;"></td>
  </tr>
</table>
